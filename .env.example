# Copy to .env and fill in what you have. Nothing here is required for the
# local demo: every capability that needs a key reports itself as unconfigured
# instead of failing quietly.
#
# This file is a template and is committed. Never put a real key here - `.env`
# is gitignored and the right place for secrets. Values written as placeholders
# (YOUR_..., <...>, changeme) are treated as unset by the app, so a copied
# template cannot look like a working configuration.

# --- API ---------------------------------------------------------------
PORT=4000
# PostgreSQL connection string. When unset the API uses embedded PostgreSQL
# (PGlite) under .copilot-data/pg, so no database server is needed.
# Neon works as-is; keep `sslmode=require` (or verify-full) in the URL.
# DATABASE_URL=postgres://user:password@host.neon.tech/neondb?sslmode=require
#
# Integration tests only run against a *separate, disposable* database. Point
# this at its own database (or Neon branch), never at the one above.
# TEST_DATABASE_URL=postgres://user:password@host.neon.tech/copilot_test?sslmode=require
COPILOT_ARTIFACTS=.copilot-data

# --- OpenAdapt engine --------------------------------------------------
# Interpreter that has openadapt-flow installed (see README).
PYTHON_BIN=.venv-flow/Scripts/python.exe
# PYTHON_BIN=.venv-flow/bin/python
OPENADAPT_BRIDGE=packages/workflow/python/copilot_bridge.py
ENGINE_TIMEOUT_MS=300000

# --- Demo applications -------------------------------------------------
# Project-owned demos. They exercise the pipeline; they are not evidence about
# a third-party product.
DEMO_CRM_URL=http://127.0.0.1:4300
DEMO_STOCK_URL=http://127.0.0.1:4400

# --- Independent applications (M5, optional) ---------------------------
# Nothing is contacted unless these are set. `pnpm tsx scripts/m5-onboard-app.ts
# check` prints exactly which of them are missing. Use an isolated test tenant
# and a test role; never a production workspace.
# SYNTASK_BASE_URL=
# SYNTASK_API_TOKEN=
# TWENTY_BASE_URL=
# TWENTY_API_TOKEN=
#
# The API's own URL and an administrator token, used by the onboarding CLI:
# COPILOT_API_URL=http://127.0.0.1:4110
# COPILOT_TOKEN=

# --- Model reasoning (optional) ---------------------------------------
# Groq is the provider this project ships with. Setting GROQ_API_KEY is enough;
# LLM_PROVIDER is only needed to choose a different provider.
# With no key, intent parsing is deterministic and the plan says so.
# GROQ_API_KEY=
# LLM_PROVIDER=groq
# Default model; verified available to a Groq account.
# LLM_MODEL=openai/gpt-oss-120b
#
# Other supported providers (OPENAI_API_KEY / ANTHROPIC_API_KEY) still work:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=

# --- Embeddings / vector search (optional) -----------------------------
# Without a provider, knowledge retrieval is keyword-only and the API reports
# vector search as unconfigured. Embeddings are never fabricated.
# EMBEDDING_PROVIDER=openai

# --- Stagehand (optional) ----------------------------------------------
# Stagehand drives its own controlled Chromium session; it cannot attach to the
# extension's tab. v4 accepts `groq/<model>`, so it reuses GROQ_API_KEY.
# STAGEHAND_MODEL=groq/openai/gpt-oss-120b
# STAGEHAND_HEADLESS=true
