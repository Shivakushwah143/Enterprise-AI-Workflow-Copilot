# Copy to .env and fill in what you have. Nothing here is required for the
# local demo: every capability that needs a key reports itself as unconfigured
# instead of failing quietly.

# --- API ---------------------------------------------------------------
PORT=4000
# PostgreSQL connection string. When unset the API uses embedded PostgreSQL
# (PGlite) under .copilot-data/pg, so no database server is needed.
# DATABASE_URL=postgres://copilot:copilot@127.0.0.1:5432/copilot
COPILOT_ARTIFACTS=.copilot-data

# --- OpenAdapt engine --------------------------------------------------
# Interpreter that has openadapt-flow installed (see README).
PYTHON_BIN=.venv-flow/Scripts/python.exe
# PYTHON_BIN=.venv-flow/bin/python
OPENADAPT_BRIDGE=packages/workflow/python/copilot_bridge.py
ENGINE_TIMEOUT_MS=300000

# --- Demo applications -------------------------------------------------
DEMO_CRM_URL=http://127.0.0.1:4300
DEMO_STOCK_URL=http://127.0.0.1:4400

# --- Model reasoning (optional) ---------------------------------------
# Without these the agent uses deterministic intent parsing and says so.
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Embeddings / vector search (optional) -----------------------------
# Without a provider, knowledge retrieval is keyword-only and the API reports
# vector search as unconfigured. Embeddings are never fabricated.
# EMBEDDING_PROVIDER=openai

# --- Stagehand (optional) ----------------------------------------------
# Stagehand drives its own controlled Chromium session; it cannot attach to the
# extension's tab. Needs one of the model keys above.
# STAGEHAND_MODEL=gpt-4o-mini
# STAGEHAND_HEADLESS=true
