{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@copilot/shared": ["packages/shared/src/index.ts"],
      "@copilot/knowledge": ["packages/knowledge/src/index.ts"],
      "@copilot/workflow": ["packages/workflow/src/index.ts"],
      "@copilot/agent": ["packages/agent/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "research", "apps/extension/.output", "apps/extension/.wxt"]
}
