{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["chrome", "node"],
    "baseUrl": ".",
    "noEmit": true,
    "paths": {
      "@copilot/shared": ["../../packages/shared/src/index.ts"]
    }
  },
  "include": ["entrypoints/**/*", "wxt.config.ts", "env.d.ts", ".wxt/**/*"],
  // The root config excludes this app (it needs JSX + chrome types), so the
  // exclusion has to be replaced here rather than inherited.
  "exclude": ["node_modules", ".output", ".wxt"]
}
